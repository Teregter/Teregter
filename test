#include <stdio.h>
#include <assert.h>
#include "Lab1.c"

// Функция для тестирования
void runTests() {
    assert(countWords("Hello world") == 2);
    assert(countWords("  Leading spaces") == 2);
    assert(countWords("Trailing spaces   ") == 2);
    assert(countWords("Multiple   spaces between words") == 4);
    assert(countWords("") == 0);
    assert(countWords("OneWord") == 1);
    assert(countWords("Numbers 123 and words") == 3);
    printf("All tests passed!\n");
}

int main() {
    runTests();
    return 0;
}
